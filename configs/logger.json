{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "simple": {
            "format": "[%(levelname)s|%(module)s|L%(lineno)d] %(asctime)s: %(message)s",
            "datefmt": "%Y-%m-%dT%H:%M:%S%z"
        },
        "json": {
            "class": "src.core.logger.JsonFormatter",
            "fmt_keys": {
                "level": "levelname",
                "message": "message",
                "timestamp": "timestamp",
                "logger": "name",
                "module": "module",
                "function": "funcName",
                "line": "lineno",
                "thread_name": "threadName"
            }
        }
    },
    "handlers": {
        "console": {
            "class": "logging.StreamHandler",
            "level": "DEBUG",
            "formatter": "simple",
            "stream": "ext://sys.stdout"
        },
        "stderr": {
            "class": "logging.StreamHandler",
            "level": "WARNING",
            "formatter": "simple",
            "stream": "ext://sys.stderr"
        },
        "file_json": {
            "class": "logging.handlers.RotatingFileHandler",
            "level": "DEBUG",
            "formatter": "json",
            "filename": "logs/app.log.jsonl",
            "maxBytes": 10000000,
            "backupCount": 3
        },
        "fallback_file": {
            "class": "logging.handlers.RotatingFileHandler",
            "level": "ERROR",
            "formatter": "json",
            "filename": "logs/production_errors.log",
            "maxBytes": 50000000,
            "backupCount": 5
        }
    },
    "filters": {
        "sensitive_data": {
            "class": "src.core.logger.SensitiveDataFilter"
        }
    },
    "loggers": {
        "uvicorn": {
            "level": "INFO",
            "handlers": [],
            "propagate": true
        },
        "uvicorn.access": {
            "level": "WARNING",
            "handlers": [],
            "propagate": true
        },
        "sqlalchemy.engine": {
            "level": "WARNING",
            "handlers": [],
            "propagate": true
        },
        "urllib3": {
            "level": "WARNING",
            "handlers": [],
            "propagate": true
        }
    }
}